# =============================================================================
# THIS FILE IS COMMITTED TO THE REPOSITORY AND CONTAINS REAL CREDENTIALS.
#
# That is deliberate. Private repo, four-person college project, and the
# alternative was teammates blocked on setup. Clone the repo and it just runs -
# no values to copy from anywhere.
#
# What this means for you:
#   - Do NOT make this repository public. Real database passwords and the JWT
#     secret are in git history, so deleting the file later does not undo it.
#     Before open-sourcing: rotate the Supabase passwords and JWT_SECRET,
#     re-ignore this file in .gitignore, and only then change visibility.
#   - If you change a value here, COMMIT IT. Everyone shares one dev database
#     and one seed admin; a change that stays on your laptop breaks other
#     people rather than only you.
#   - Do not paste this file into a screenshot, a slide, or the report.
#
# server/.env.example documents what every variable means.
# =============================================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5174

# ---- Database (Supabase PostgreSQL) ----
# Session pooler (port 5432) — behaves like a direct connection, so migrations work.
#
# Do NOT switch these back to the `db.<ref>.supabase.co` direct host. That hostname has an
# IPv6 address and NO IPv4 address, so it only resolves for people whose network has IPv6.
# Everybody else gets `getaddrinfo ENOTFOUND db.<ref>.supabase.co` on every request while the
# app itself boots fine — which looks like a broken clone and is not. The pooler hostname below
# publishes real IPv4 addresses and works on every network.
DATABASE_URL_DEV=postgresql://postgres.mvnkdajsyqabiuvckhag:gu6MZROlHLPGcttR@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Separate test project — used by CI and local integration tests. Never destructive-reset.
# Different region and a different pooler prefix than dev; both are correct, do not "align" them.
DATABASE_URL_TEST=postgresql://postgres.xzgszseqdfqexwocawyq:nWrvrcxQcnq4z5jf@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# ---- Auth ----
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cfc94b7eb15cf756fb3f3e0c6f1edf0377d06dfb2e3a043005fcc29b01eb7aa1
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=sponsorsync_session

# ---- Seed administrator (idempotent; created on first db:seed) ----
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@12345
