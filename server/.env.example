# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5174

# ---- Database (Supabase PostgreSQL) ----
# Use the SESSION POOLER host (port 5432), not the direct `db.<ref>.supabase.co` host.
# The direct host is IPv6-only: it resolves on an IPv6 network and fails with
# `getaddrinfo ENOTFOUND` on an IPv4-only one, so the app runs for some teammates and not
# others. The pooler has IPv4 and still behaves like a direct connection, so migrations work.
# Copy it from the Supabase dashboard: Project Settings → Database → Connection string →
# "Session pooler". Note the username is `postgres.<project-ref>`, not plain `postgres`.
DATABASE_URL_DEV=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Separate test project — used by CI and local integration tests. Never destructive-reset.
DATABASE_URL_TEST=postgresql://postgres.TEST_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Auth ----
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=sponsorsync_session

# There is no mail sender, and nothing in the app needs one: both OTP flows (forgotten password,
# email change) were removed. Admins reset passwords and change addresses through /api/users.
# See docs/roles-and-access.md. If a feature ever needs to send mail, that is a new dependency
# and an approval gate under AGENTS.md rule 12.

# ---- Seed administrator (idempotent; created on first db:seed) ----
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
