# Make the Node version in package.json "engines" a hard requirement, not a warning.
#
# Without this, npm prints a yellow EBADENGINE notice and installs anyway. A teammate on
# Node 20 scrolls past it, `npm ci` succeeds, and the failure surfaces later as an unrelated
# runtime error. Failing at install with "required: {node:>=24}" costs five seconds instead
# of an evening.
#
# See .nvmrc — `nvm use` picks the right version automatically.
engine-strict=true
